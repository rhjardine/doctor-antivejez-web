# Base de Datos
DATABASE_URL="postgresql://postgres:Engineer2025**@localhost:5433/doctor_antivejez"

# NextAuth
NEXTAUTH_SECRET="tu-secret-key-super-segura"
NEXTAUTH_URL="http://localhost:3000"

# Opcional para producción
NODE_ENV="development"

# Token secreto para el endpoint admin de reparación de contraseñas de pacientes
# Generar con: openssl rand -base64 32
ADMIN_REPAIR_SECRET="cambia-esto-por-un-secreto-seguro"

# --- AI GATEWAY CONFIGURATION (H24) ---
# Primary Gateway: OpenRouter (Higher Availability)
AI_GATEWAY_URL="https://openrouter.ai/api/v1"
AI_GATEWAY_KEY="sk-or-v1-..." # OpenRouter API Key

# Secondary Gateway: SiliconFlow (Geopolitical Resilience)
AI_GATEWAY_SECONDARY_URL="https://api.siliconflow.cn/v1"
AI_GATEWAY_SECONDARY_KEY="sk-..." # SiliconFlow API Key

# --- DICTADO POR VOZ (B2) ---
# Apagado por defecto. Sin estas variables el botón de dictado no aparece y la
# Server Action rechaza cualquier llamada: mergear B2 no activa nada.
#
# ⚠️ NO ENCENDER con proveedor externo en consulta real hasta que exista BAA/DPA
# firmado. El audio de un dictado clínico es PHI aunque no se pronuncie el
# nombre del paciente.
#
# Ambas deben estar en "true": la del servidor es la que autoriza, la del
# cliente solo decide si se pinta el botón.
DICTADO_VOZ_ENABLED="false"
NEXT_PUBLIC_DICTADO_VOZ_ENABLED="false"

# Adaptador de transcripción: "echo" (por defecto) o "whisper".
#   echo    → no transcribe, devuelve un texto de prueba. NO sale audio a terceros.
#   whisper → OpenAI Whisper. Requiere OPENAI_API_KEY; sin ella degrada a echo.
DICTADO_VOZ_PROVEEDOR="echo"
